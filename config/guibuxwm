# guibuxwm default configuration
#
# Copy to ~/.config/guibuxwm/config (or pass -c /path/to/config).
# Every line mirrors the built-in default; change what you want.
# A keybind with the same modifiers+key as a default replaces it.

# terminal command started by Mod+Return
term = gnome-terminal

# Wayland app_id of the terminal: excluded from window position restore.
# Defaults to the command name from `term`; GNOME Terminal reports
# org.gnome.Terminal, not gnome-terminal.
term_app_id = org.gnome.Terminal

# preferred apps shown above the command box (Mod+e) prompt, up to 5.
# Format: Name;command[;icon] — icon is a theme icon name or an
# absolute path; without it the command name is used. A missing
# theme or icon is skipped silently (no icon, no error). Up/Down
# selects, Enter launches.
preferred_app1 = Firefox;firefox;firefox
preferred_app2 = Slack;slack;slack
preferred_app3 = Nautilus;nautilus;nautilus
preferred_app4 = VirtUI-GUI;virtui-gui;virtui-gui
preferred_app5 = Chrome;flatpak run com.google.Chrome;chromium

# icon theme for launcher icons (leave unset to use the gtk
# gtk-icon-theme-name, then Adwaita)
#icon_theme = Adwaita

# keyboard (xkb names; leave unset for the system default)
xkb_layout = fr
#xkb_variant = osd
#xkb_options = caps:swapscape

# keybinds: MODS+key: action
# modifiers: Mod (Super), Shift, Alt, Ctrl
# actions: terminal, close, fullscreen, tile, launcher, focus-next,
#          quit, workspace:N, move-workspace:N,
#          move-monitor-left, move-monitor-right,
#          snap-left, snap-right, snap-top, snap-bottom,
#          switch-ws-left, switch-ws-right,
#          volume-up, volume-down, mute, mic-up, mic-down, mic-mute,
#          brightness-up, brightness-down, power
keybind = Mod+Return: terminal
keybind = Mod+q: close
keybind = Mod+f: fullscreen
keybind = Mod+t: tile
keybind = Mod+e: launcher
keybind = Alt+Tab: focus-next
keybind = Mod+1: workspace:1
keybind = Mod+2: workspace:2
keybind = Mod+3: workspace:3
keybind = Mod+4: workspace:4
keybind = Mod+Shift+1: move-workspace:1
keybind = Mod+Shift+2: move-workspace:2
keybind = Mod+Shift+3: move-workspace:3
keybind = Mod+Shift+4: move-workspace:4
keybind = Mod+Shift+Left: move-monitor-left
keybind = Mod+Shift+Right: move-monitor-right
keybind = Mod+Left: snap-left
keybind = Mod+Right: snap-right
keybind = Mod+Shift+Up: snap-top
keybind = Mod+Shift+Down: snap-bottom
keybind = Mod+Up: fullscreen
keybind = Mod+Shift+q: quit
keybind = Alt+Escape: quit
keybind = Mod+Alt+Escape: quit
keybind = Ctrl+Alt+Left: switch-ws-left
keybind = Ctrl+Alt+Right: switch-ws-right
keybind = Mod+h: show-help
keybind = Mod+p: power
keybind = Mod+l: topbar-items

# audio (media keys XF86AudioRaiseVolume/LowerVolume/Mute/MicMute also
# work without any binding; topbar: scroll adjusts, left click mutes,
# right click opens pavucontrol)
#keybind = Mod+m: mute
#keybind = Mod+Shift+m: mic-mute

# brightness (hardware keys XF86MonBrightnessUp/Down also work without
# any binding)
#keybind = Mod+Prior: brightness-up
#keybind = Mod+Next: brightness-down

# colors (#rrggbb)
color_bg = #1e1e2e
color_border = #45475a
color_highlight = #3a3c55
color_text = #ffffff
color_dim = #8888aa
# topbar (openSUSE green)
topbar_bg = #8839ef
topbar_text = #1e1e2e

# topbar height in pixels (default: 24)
topbar_height = 30

# topbar font size in pixels (default: 16)
topbar_font_size = 18

# vertical padding of window pills inside the topbar in pixels (default: 2)
# smaller = taller pills, 0 = pills fill the whole topbar height
topbar_win_pad = 2

# right-side topbar indicators, comma-separated, in layout order.
# available: network, volume, mic, battery, notifications, clock
# (default: network, volume, mic, battery, notifications, clock)
#topbar_items = network, volume, mic, battery, notifications, clock

# desktop background image (PNG or JPEG), used for workspaces
# without their own image
background = /home/aginies/Pictures/Emission_nebulae_in_Cassiopeia.jpg

# per-workspace background images (optional, fall back to background)
#background1 = /path/to/ws1.jpg
#background2 = /path/to/ws2.jpg
#background3 = /path/to/ws3.jpg
#background4 = /path/to/ws4.jpg

# background scale mode: stretch, fit, fill, tile (default: fill)
#background_scale = fill

# screensaver timeout in seconds (0 = disabled, default: 300)
screensaver_timeout = 300

# lock the screen on the idle timeout, before the screensaver turns the
# monitors off (true = enabled, false = manual lock only; default: true)
lock_on_idle = true

# focus follows mouse: keyboard focus changes when cursor enters a window
# (true = enabled, false = click-to-focus only; default: true)
focus_follow_mouse = true

# overview: show colored pills for workspace numbers (default: true)
overview_workspace_colors = true

# per-workspace overview colors (#rrggbb)
overview_ws_color1 = #3a86ff
overview_ws_color2 = #86efac
overview_ws_color3 = #ffb703
overview_ws_color4 = #c084fc

# animations: master switch (default: true) and duration in ms
# (default: 200, 0 = off)
effects = true
effects_duration_ms = 300

# window open animation: scale, slide, none (default: scale)
window_open_effect = scale

# remember each app's last monitor/workspace/position/size and restore
# it on the next launch (default: true); the terminal is excluded.
# state file: $XDG_STATE_HOME/guibuxwm/window-positions
restore_positions = true

# notification panel animation: slide, none (default: slide)
notify_effect = slide

# on-screen display for volume/mic/brightness changes: centered box with
# label, value and a bar (default: true; false = no OSD)
osd = true

# OSD auto-hide timeout in milliseconds (0 = off, default: 1500)
osd_timeout_ms = 1500

# monitor arrangement (default: auto-arrange; wins over GUIBUX_OUTPUTS)
# entry: NAME@XxY[:WxH[:ROT]] or NAME@off; edited live by the
# guibuxwm-output tool (see docs/multi-monitor.md)
#outputs = DP-1@0x0,HDMI-A-1@1920x0

# render backend: auto (default, wlroots picks), gles2, vulkan, pixman.
# vulkan is the fastest on modern GPUs; auto prefers gles2 on wlroots 0.20.
# An explicit WLR_RENDERER env var always wins over this key.
#renderer = vulkan
